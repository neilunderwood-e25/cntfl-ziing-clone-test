# Copy to .env.local and fill in secrets. Only this .env.example is tracked.

# --- CMS provider selection (lib/cms/index.ts) ---
# Registered adapters: contentful
CMS_PROVIDER=contentful

# --- Contentful delivery (required) ---
CONTENTFUL_SPACE_ID=
# Content Delivery API token (published content)
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_ENVIRONMENT=master

# --- Contentful preview (draft content; optional) ---
# Content Preview API token
CONTENTFUL_PREVIEW_TOKEN=
# Shared secret unlocking ?preview=<secret> URLs; configure the same URL
# pattern in Contentful's content-preview settings. Generate: openssl rand -hex 16
CONTENTFUL_PREVIEW_SECRET=

# --- Contentful hosts (default shown; override for EU data residency etc.) ---
# CONTENTFUL_GRAPHQL_HOST=graphql.contentful.com

# --- Management API (only for scripts/create-content-model.mjs; not used at runtime) ---
CONTENTFUL_MANAGEMENT_TOKEN=

# --- CDN cache TTLs (lib/cache/headers.ts) ---
# No purge wired (boilerplate default): keep s-maxage short (300 = 5 min).
# After wiring tag purge (Vercel/Akamai playbooks): raise to 86400.
CDN_CACHE_S_MAXAGE=300
CDN_CACHE_STALE_WHILE_REVALIDATE=86400

# --- CMS publish webhook → cache purge (app/api/webhooks/cms/purge) ---
# Shared secret; set the same value in the Contentful webhook config as a
# custom `x-webhook-secret` header. Generate with: openssl rand -hex 32
CMS_WEBHOOK_SECRET=
